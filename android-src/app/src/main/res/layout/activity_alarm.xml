<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/alarm_bg">

    <!-- Indicador de tipo de aviso -->
    <TextView
        android:id="@+id/alarm_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/alarm_eyebrow"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:layout_marginBottom="12dp" />

    <!-- Nombre del paciente -->
    <TextView
        android:id="@+id/alarm_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/alarm_name"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <!-- Servicio · Box -->
    <TextView
        android:id="@+id/alarm_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/alarm_detail"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <!-- Botón Detener -->
    <Button
        android:id="@+id/btn_dismiss"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="Detener"
        android:textSize="17sp"
        android:backgroundTint="@color/alarm_dismiss_bg"
        android:textColor="@color/alarm_dismiss_text"
        android:layout_marginBottom="16dp" />

    <!-- Botón Posponer -->
    <Button
        android:id="@+id/btn_snooze"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="Posponer 5 min"
        android:textSize="17sp"
        android:textColor="@color/alarm_snooze_text" />

</LinearLayout>
