rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == "espaciomimart36@gmail.com";
    }

    function esAdminDepi() {
      return request.auth != null
        && (request.auth.token.email == "espaciomimart36@gmail.com"
         || request.auth.token.email == "farmaciacentral36@gmail.com"
         || request.auth.token.email == "depi.mimart@gmail.com"
         || request.auth.token.email == "gimenadepi@gmail.com");
    }

    function noCambiaCamposAdmin() {
      return !(request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['membershipActive', 'membresia', 'hoursBalance', 'role']));
    }

    // Acceso privado a "Pacientes de la Doctora" — mismo estilo que
    // esAdminDepi(): lista de emails literal, nunca abierto a request.auth
    // != null solo. Ningún otro profesional ni el resto de las reglas
    // generales (clients, reservas, etc.) puede acceder a estas colecciones.
    function esDoctora() {
      return request.auth != null
        && (request.auth.token.email == "espaciomimart36@gmail.com"
         || request.auth.token.email == "doctora.mimart@gmail.com");
    }

    match /clients/{clientId} {
      allow read:   if true;
      allow write:  if esAdmin();
      allow update: if noCambiaCamposAdmin();
    }

    match /historias/{historiaId} {
      allow read:   if esAdmin();
      allow write:  if true;
    }

    match /reservas/{reservaId} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if esAdmin();
    }

    // Control atomico anti-solapamiento de turnos
    match /reservas_slots/{slotId} {
      allow read:   if true;
      allow write:  if true;
    }

    match /horarios/{horarioId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    match /calendarExceptions/{excId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    match /configuracion/{docId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    match /services/{serviceId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    // Alias viejo — solo admin (no lo usa el código actual)
    match /reservas_depi/{reservaId} {
      allow read, create, update, delete: if esAdminDepi();
    }

    // Colección real del sistema de depilación (camelCase) — la paciente
    // reserva sin login (read/create públicos, para ver horarios libres y
    // crear su turno), pero modificar o borrar un turno ya creado requiere
    // esAdminDepi() real (antes era "if true" también para update/delete:
    // cualquiera en internet podía borrar o alterar cualquier turno).
    match /reservasDepi/{reservaId} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if esAdminDepi();
    }

    // Bloqueos automáticos del sistema de depilación — la paciente los crea
    // al reservar (read/create públicos); tocarlos después de creados
    // (liberar un bloqueo, desbloquear un día) requiere esAdminDepi().
    match /calendarExceptionsDepi/{excId} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if esAdminDepi();
    }

    // Configuración de combos (duraciones, precios)
    match /config/{docId} {
      allow read, write: if true;
    }

    match /consultas/{consultaId} {
      allow create: if true;
      allow read, update, delete: if esAdmin();
    }

    match /pedidosKit/{pedidoId} {
      allow read:   if esAdmin() || request.auth != null;
      allow create: if true;
      allow write:  if esAdmin();
    }

    // Curso de Automaquillaje — inscripciones públicas, gestión solo admin
    match /cursoMaquillaje/{docId} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if esAdmin();
    }

    // Sesiones del curso — admin las crea/edita, todos pueden leer
    match /cursoSesiones/{docId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    // Cobros de sesión depilación — registros financieros internos, nunca
    // leídos ni escritos por la paciente: solo esAdminDepi().
    match /cobrosSesionDepi/{cobroId} {
      allow read, write: if esAdminDepi();
    }

    // Cierres de jornada depilación — ídem, solo esAdminDepi().
    match /cierresJornadaDepi/{cierreId} {
      allow read, write: if esAdminDepi();
    }

    // Control de consultas iniciales — solo admin Gimena
    match /control_consultas_iniciales/{docId} {
      allow read, write: if esAdmin();
    }

    // Tokens FCM para las apps Android — un documento por dispositivo+app
    // (id: {uid}_{appId}_{installId}). Solo el admin autenticado puede
    // leer/escribir, y únicamente sus propios tokens (uid del documento debe
    // coincidir con quien hace la request) — así un admin no puede leer o
    // pisar el token de otro dispositivo/usuario.
    match /deviceTokens/{tokenId} {
      allow read:   if esAdmin() && resource.data.uid == request.auth.uid;
      allow create: if esAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if esAdmin() && resource.data.uid == request.auth.uid;
    }

    // Bandeja de actividad (Mimar T Inteligente, punto 2) — la genera el
    // Admin SDK desde Cloud Functions, que no pasa por estas reglas. Desde
    // el cliente solo se permite un update acotado a "leído"/"atendido":
    // nunca se puede reescribir el resumen ni el resto del evento.
    match /activityLog/{eventId} {
      allow read: if esAdmin();
      allow create, delete: if false;
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['leidoPor', 'atendido', 'atendidoPor', 'atendidoAt']);
    }

    // Resumen diario de cumpleaños (punto 4) — lo escribe solo la función
    // programada (Admin SDK, sin pasar por estas reglas).
    match /resumenesCumpleanos/{fecha} {
      allow read:  if esAdmin();
      allow write: if false;
    }

    // Seguimiento de contactos por WhatsApp (punto 3) — mismo criterio que
    // control_consultas_iniciales: solo admin, sin acceso público.
    match /contactosWhatsApp/{contactoId} {
      allow read, write: if esAdmin();
    }

    // ── Pacientes de la Doctora — módulo privado, aislado de "clients" ─────
    // Nunca se guardan estos pacientes en la colección "clients" (esa tiene
    // "allow read: if true" — exponerlos ahí violaría la privacidad pedida).
    // Doc id = DNI normalizado (solo dígitos), mismo criterio que "clients".
    match /pacientesDoctora/{dni} {
      allow read, write: if esDoctora();
    }

    // Qué fechas aceptan turnos nuevos, y con qué horario/duración. Doc id =
    // fecha ISO ("YYYY-MM-DD"). Deshabilitar (habilitada:false) nunca borra
    // el documento ni los turnos ya creados para esa fecha — solo bloquea
    // reservas nuevas.
    match /fechasHabilitadasDoctora/{fecha} {
      allow read, write: if esDoctora();
    }

    match /turnosDoctora/{turnoId} {
      allow read, write: if esDoctora();
    }

    // Reserva atómica de horario (equivalente privado de reservas_slots).
    // Una vez ocupado por un turno, solo se puede liberar (ocupado:false) o
    // reafirmar el mismo turno — nunca pisar el horario de otro turno,
    // incluso si dos operaciones intentan guardar al mismo tiempo.
    match /slotsDoctora/{slotId} {
      allow read:   if esDoctora();
      allow create: if esDoctora();
      allow update: if esDoctora()
        && (resource.data.ocupado == false || resource.data.turnoId == request.resource.data.turnoId);
      allow delete: if esDoctora();
    }

    // Seguimiento de WhatsApp de la doctora — aislado de contactosWhatsApp
    // (otro alcance, otros profesionales) por la misma razón que
    // pacientesDoctora está aislado de clients.
    match /contactosWhatsAppDoctora/{contactoId} {
      allow read, write: if esDoctora();
    }

    // Configuración propia del módulo (por ahora, solo la ubicación del
    // consultorio para los mensajes de WhatsApp) — aislada de
    // "configuracion", que ya tiene otro alcance y otro dueño.
    match /configDoctora/{docId} {
      allow read, write: if esDoctora();
    }

    // Movimientos de dinero (cobro/devolución) por consulta — es un
    // registro contable append-only a propósito: nunca se edita ni se
    // borra un movimiento ya creado (una corrección es SIEMPRE un
    // movimiento nuevo que referencia al anterior), así se conserva la
    // trazabilidad completa incluso a nivel de reglas, no solo por
    // convención de la app.
    match /movimientosDineroDoctora/{movimientoId} {
      allow read:   if esDoctora();
      allow create: if esDoctora();
      allow update, delete: if false;
    }

    // Cierre de jornada — snapshot congelado por fecha (doc id = fecha
    // ISO). "create"/"update" cubren guardar y también reabrir (que solo
    // cambia estado + agrega al historial), pero nunca se borra un cierre.
    match /cierresDoctora/{fecha} {
      allow read:   if esDoctora();
      allow create, update: if esDoctora();
      allow delete: if false;
    }

  }
}
