rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == "espaciomimart36@gmail.com";
    }

    function esAdminDepi() {
      return request.auth != null
        && (request.auth.token.email == "espaciomimart36@gmail.com"
         || request.auth.token.email == "farmaciacentral36@gmail.com"
         || request.auth.token.email == "depi.mimart@gmail.com"
         || request.auth.token.email == "gimenadepi@gmail.com");
    }

    function noCambiaCamposAdmin() {
      return !(request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['membershipActive', 'membresia', 'hoursBalance', 'role']));
    }

    match /clients/{clientId} {
      allow read:   if true;
      allow write:  if esAdmin();
      allow update: if noCambiaCamposAdmin();
    }

    match /historias/{historiaId} {
      allow read:   if esAdmin();
      allow write:  if true;
    }

    match /reservas/{reservaId} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if esAdmin();
    }

    // Control atomico anti-solapamiento de turnos
    match /reservas_slots/{slotId} {
      allow read:   if true;
      allow write:  if true;
    }

    match /horarios/{horarioId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    match /calendarExceptions/{excId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    match /configuracion/{docId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    match /services/{serviceId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    // Alias viejo — solo admin (no lo usa el código actual)
    match /reservas_depi/{reservaId} {
      allow read, create, update, delete: if esAdminDepi();
    }

    // Colección real del sistema de depilación (camelCase)
    match /reservasDepi/{reservaId} {
      allow read, write: if true;
    }

    // Bloqueos automáticos del sistema de depilación
    match /calendarExceptionsDepi/{excId} {
      allow read, write: if true;
    }

    // Configuración de combos (duraciones, precios)
    match /config/{docId} {
      allow read, write: if true;
    }

    match /consultas/{consultaId} {
      allow create: if true;
      allow read, update, delete: if esAdmin();
    }

    match /pedidosKit/{pedidoId} {
      allow read:   if esAdmin() || request.auth != null;
      allow create: if true;
      allow write:  if esAdmin();
    }

    // Curso de Automaquillaje — inscripciones públicas, gestión solo admin
    match /cursoMaquillaje/{docId} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if esAdmin();
    }

    // Sesiones del curso — admin las crea/edita, todos pueden leer
    match /cursoSesiones/{docId} {
      allow read:   if true;
      allow write:  if esAdmin();
    }

    // Cobros de sesión depilación — panel no usa Firebase Auth, acceso libre
    match /cobrosSesionDepi/{cobroId} {
      allow read, write: if true;
    }

    // Cierres de jornada depilación — panel no usa Firebase Auth, acceso libre
    match /cierresJornadaDepi/{cierreId} {
      allow read, write: if true;
    }

    // Control de consultas iniciales — solo admin Gimena
    match /control_consultas_iniciales/{docId} {
      allow read, write: if esAdmin();
    }

    // Tokens FCM para las apps Android — un documento por dispositivo+app
    // (id: {uid}_{appId}_{installId}). Solo el admin autenticado puede
    // leer/escribir, y únicamente sus propios tokens (uid del documento debe
    // coincidir con quien hace la request) — así un admin no puede leer o
    // pisar el token de otro dispositivo/usuario.
    match /deviceTokens/{tokenId} {
      allow read:   if esAdmin() && resource.data.uid == request.auth.uid;
      allow create: if esAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if esAdmin() && resource.data.uid == request.auth.uid;
    }

    // Bandeja de actividad (Mimar T Inteligente, punto 2) — la genera el
    // Admin SDK desde Cloud Functions, que no pasa por estas reglas. Desde
    // el cliente solo se permite un update acotado a "leído"/"atendido":
    // nunca se puede reescribir el resumen ni el resto del evento.
    match /activityLog/{eventId} {
      allow read: if esAdmin();
      allow create, delete: if false;
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['leidoPor', 'atendido', 'atendidoPor', 'atendidoAt']);
    }

    // Resumen diario de cumpleaños (punto 4) — lo escribe solo la función
    // programada (Admin SDK, sin pasar por estas reglas).
    match /resumenesCumpleanos/{fecha} {
      allow read:  if esAdmin();
      allow write: if false;
    }

    // Seguimiento de contactos por WhatsApp (punto 3) — mismo criterio que
    // control_consultas_iniciales: solo admin, sin acceso público.
    match /contactosWhatsApp/{contactoId} {
      allow read, write: if esAdmin();
    }

  }
}
